{
  "_about": {
    "dataset": "STRUM — dyadic multimodal neuroergonomics recordings (SCCN, UC San Diego)",
    "purpose": "The standard structure of the STRUM experiment: five canonical blocks of missions, with mission onsets and durations measured across every complete instance in the dataset.",
    "generated_by": "viz/build_structure.py",
    "sources": [
      ".context/block-structure.tsv",
      ".context/mission-events.tsv",
      ".context/session-blocks.tsv"
    ],
    "how_measured": "scripts/extract_task_structure.py reads every session's events.tsv, resolves block intervals with strum_bids.segments.resolve_block_intervals, identifies each block by its mission sequence (canonical_block), and takes the median onset and duration of each mission position over the COMPLETE instances of that block. A block counts as complete only if its mission sequence matches the canonical one AND every mission is bounded — when a recording starts mid-mission that mission emits only an end marker, and a sequence-only check would wrongly call the block complete.",
    "caveats": [
      "Onsets and durations are MEDIANS. Missions are event-driven, not fixed-length: the observed range is given per mission and is wide.",
      "A block's timeline starts at 0 = that block's first mission onset. Blocks are separated by lulls, which are not part of any block.",
      "Mission names encode the two members' roles in order (participant 0, participant 1) — verified, see role_evidence."
    ],
    "role_evidence": {
      "claim": "A mission named <condition>-<X>-<Y> assigns role X to participant 0 and role Y to participant 1.",
      "test": "Which member emits the role-specific events, over 24 recordings.",
      "results": [
        "indiv-pan-watch: pancam_agent_visible / pancam_reported / pancam_false_report are 100% participant 0",
        "indiv-watch-pan: the same three families are 100% participant 1",
        "indiv-drive-watch: stimulus_curbside 2791 p0 vs 6 p1",
        "indiv-watch-drive: stimulus_curbside 4 p0 vs 1490 p1",
        "coop-vehicle-aerial: stimulus_curbside 95% p0",
        "coop-aerial-vehicle: stimulus_curbside 97% p1",
        "coop-movetogether: stimulus_curbside 48% / 52% — symmetric",
        "coop-secureperimeter: response_button 87% 'both' — symmetric"
      ]
    }
  },
  "role_gloss": {
    "pan": "panoramic camera — scan the 360° feed and report agents",
    "watch": "supporting watch — monitor, answer queries, no primary vehicle role",
    "drive": "drive the ground vehicle along the curbside route",
    "vehicle": "ground vehicle",
    "aerial": "aerial vehicle"
  },
